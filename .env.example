# Copy to .env (never commit it).

# Host path of the confidential dataset (mounted read-only at /data in the api container).
# It can be the TUM_SociAI/ folder the command-line conciliador uses (same dataset).
DATA_DIR=C:/path/to/TUM_SociAI

# Used when running the backend outside Docker (inside Docker it points to the db service).
DATABASE_URL=postgresql+psycopg://revisor:revisor@localhost:5432/revisor

# LLM provider: fake | anthropic | openai | gemini
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
# With LLM_PROVIDER=anthropic and LLM_API_KEY empty, the standard SDK variable is used instead.
# It is also the key the command-line conciliador reads (python -m conciliador ... --contenido).
ANTHROPIC_API_KEY=
LLM_MAX_CONCURRENCY=4

# Sending PDFs to an external LLM (vision backend of app/lectura) stays disabled unless this is true.
ALLOW_EXTERNAL_LLM=false

CACHE_DIR=./cache

# Google Drive as a source of files (optional). Credentials JSON of a service account or an OAuth
# desktop app, and where the OAuth token is kept. Inside Docker these are set to /secrets/...
GOOGLE_CREDENTIALS=../.secrets/credentials.json
GOOGLE_TOKEN=../.secrets/token.json

# PDF reading with Tesseract (spa+eng+fra+osd models). Leave empty to use the system defaults.
TESSERACT_CMD=
TESSDATA_DIR=
OCR_LANGS=spa+eng+fra
OCR_DPI=200
OCR_WORKERS=4
CORS_ORIGINS=http://localhost:5173
